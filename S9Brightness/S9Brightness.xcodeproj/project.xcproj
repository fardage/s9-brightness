{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "Sources", "target-membership": [ "S9Brightness" ] },
    { "kind": "folder", "path": "Resources", "target-membership": [ "S9Brightness" ] },
    { "kind": "folder", "path": "Tests", "target-membership": [ "S9BrightnessTests" ] },
    { "path": "Info.plist" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/S9Brightness.app", "id": "E1E5A2888D78A0830C386898", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/S9BrightnessTests.xctest", "id": "254B817862552BEA72BC570E", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "S9Brightness",
      "id": "5B9B0A1C2D3E4F5061728394",
      "product": "Products/S9Brightness.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "CODE_SIGN_ENTITLEMENTS": "S9Brightness.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "5",
        "DEVELOPMENT_TEAM": "7C48W538SL",
        "ENABLE_HARDENED_RUNTIME": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "S9 Brightness",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_LSUIElement": "YES",
        "INFOPLIST_KEY_NSLocalNetworkUsageDescription": "S9 Brightness finds your Samsung monitor on the local network and sets its backlight.",
        "MARKETING_VERSION": "1.2.2",
        "PRODUCT_BUNDLE_IDENTIFIER": "ch.tseng.S9Brightness",
        "PRODUCT_NAME": "$(TARGET_NAME)",
      },
    }, {
      "name": "S9BrightnessTests",
      "id": "5B9B0A1C2D3E4F5061728395",
      "product": "Products/S9BrightnessTests.xctest",
      "product-type": "bundle.unit-test",
      "test-host-target": "S9Brightness",
      "dependencies": [
        "S9Brightness",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "BUNDLE_LOADER": "$(TEST_HOST)",
        "CODE_SIGN_STYLE": "Automatic",
        "DEVELOPMENT_TEAM": "7C48W538SL",
        "GENERATE_INFOPLIST_FILE": "YES",
        "PRODUCT_BUNDLE_IDENTIFIER": "ch.tseng.S9BrightnessTests",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "TEST_HOST": "$(BUILT_PRODUCTS_DIR)/S9Brightness.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/S9Brightness",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "DEBUG_INFORMATION_FORMAT[config=Debug]": "dwarf",
    "DEBUG_INFORMATION_FORMAT[config=Release]": "dwarf-with-dsym",
    "ENABLE_TESTABILITY[config=Debug]": "YES",
    "MACOSX_DEPLOYMENT_TARGET": "14.0",
    "ONLY_ACTIVE_ARCH[config=Debug]": "YES",
    "SDKROOT": "macosx",
    "SWIFT_ACTIVE_COMPILATION_CONDITIONS[config=Debug]": "DEBUG $(inherited)",
    "SWIFT_COMPILATION_MODE[config=Release]": "wholemodule",
    "SWIFT_OPTIMIZATION_LEVEL[config=Debug]": "-Onone",
    "SWIFT_VERSION": "5.0",
  },
}
